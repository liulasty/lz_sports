# ==============================================================================
# 项目环境变量示例文件 (.env.example)
# 说明：
# 1. 复制此文件并重命名为 .env，根据实际环境修改占位符内容
# 2. .env 文件已加入 .gitignore，不会提交到代码仓库，可放心填写敏感信息
# 3. 等号前后不要加空格，值无需加引号（特殊字符除外）
# 4. 所有 <占位符> 需替换为实际值，删除尖括号后使用
# ==============================================================================

# ------------------------------ 数据库配置 ------------------------------
# MySQL 连接地址（替换<数据库地址>、<数据库名>，时区保持GMT%2B8）
DB_URL=jdbc:mysql://<数据库地址>:3306/<数据库名>?serverTimezone=GMT%2B8&characterEncoding=utf-8&useSSL=false
# Docker环境下的MySQL连接地址（host.docker.internal对应宿主机IP）
DB_URL_DOCKER=jdbc:mysql://host.docker.internal:3306/<数据库名>?serverTimezone=GMT%2B8&characterEncoding=utf-8&useSSL=false
# MySQL 用户名（生产环境建议使用非root账号）
DB_USERNAME=<数据库用户名>
# MySQL 密码（生产环境使用强密码，定期更换）
DB_PASSWORD=<数据库密码>

# ------------------------------ Redis 配置 ------------------------------
# Redis 服务器地址（单机填IP，集群需修改配置类）
REDIS_HOST=<Redis地址>
# Docker环境下的Redis地址
REDIS_HOST_DOCKER=host.docker.internal
# Redis 端口号（默认6379）
REDIS_PORT=6379
# Redis 数据库索引（0-15，不同业务可隔离）
REDIS_DB=0
# Redis 密码（无密码则留空，生产环境建议设置）
REDIS_PASSWORD=<Redis密码>

# ------------------------------ 安全配置 ------------------------------
# Spring Security 基础认证用户名（仅基础认证使用）
SECURITY_USER_NAME=<基础认证用户名>
# Spring Security 基础认证密码
SECURITY_USER_PASSWORD=<基础认证密码>
# JWT 加密密钥（核心！生产环境替换为32位以上随机字符串）
# 生成方式：UUID.randomUUID().toString() 或随机字符组合
JWT_SECRET=<32位以上随机字符串>

# ------------------------------ 阿里云OSS配置 ------------------------------
# OSS 地域节点（如oss-cn-beijing.aliyuncs.com）
OSS_ENDPOINT=<OSS地域节点>
# OSS AccessKey ID（阿里云子账号AccessKey，仅授予OSS权限）
OSS_ACCESS_KEY_ID=<OSS AccessKey ID>
# OSS AccessKey Secret（敏感！勿提交）
OSS_ACCESS_KEY_SECRET=<OSS AccessKey Secret>
# OSS Bucket名称（全局唯一，需提前创建）
OSS_BUCKET_NAME=<OSS Bucket名称>
# 应用上传目录（无需修改，默认即可）
APP_UPLOAD_DIR=uploads

# ------------------------------ 邮件配置 ------------------------------
# 邮件服务器地址（如smtp.qq.com、smtp.163.com）
MAIL_HOST=<邮件SMTP服务器地址>
# 邮件服务器端口（如587、465）
MAIL_PORT=<邮件SMTP端口>
# 发件人邮箱账号
MAIL_USERNAME=<发件人邮箱>
# 发件人邮箱授权码（非登录密码，需在邮箱后台开启SMTP后获取）
MAIL_PASSWORD=<邮箱授权码>

# ------------------------------ 应用配置 ------------------------------
# 日志存储目录（Docker部署建议映射宿主机目录）
APP_LOG_DIR=/app/logs/lz_sports
# 应用端口号（避免与其他服务冲突）
SERVER_PORT=8080

# 激活的Spring配置文件（dev/test/prod，对应application-{profile}.yml）
SPRING_PROFILES_ACTIVE=dev